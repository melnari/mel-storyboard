<div class="mel-storyboard-object-details">
  <div class="mel-storyboard-object-details-header">
    {{#if object.image}}<img src="{{object.image}}" alt="" aria-hidden="true" />{{/if}}
    <div>
      <h2>{{object.title}}</h2>
      {{#if object.foundryLinkHtml}}{{{object.foundryLinkHtml}}}{{/if}}
    </div>
  </div>
  <dl class="mel-storyboard-object-details-list">
    <div><dt>{{labels.objectType}}</dt><dd>{{object.typeLabel}}</dd></div>
    <div><dt>{{labels.objectTitle}}</dt><dd>{{object.title}}</dd></div>
    <div><dt>{{labels.foundryUuid}}</dt><dd class="mel-storyboard-object-details-uuid">{{object.foundryUuid}}</dd></div>
    {{#if object.foundryDocumentType}}<div><dt>{{labels.foundryDocumentType}}</dt><dd>{{object.foundryDocumentType}}</dd></div>{{/if}}
  </dl>
  <section class="mel-storyboard-object-details-notes">
    <h3>{{labels.objectNote}}</h3>
    <div class="mel-storyboard-object-details-note-view" data-note-view>
      <div class="mel-storyboard-object-details-note-content" data-note-content>{{{assignmentNotesHtml}}}</div>
      <button type="button" class="mel-storyboard-object-details-edit-note" data-action="edit-note">
        <i class="fas fa-pen-to-square" aria-hidden="true"></i> {{labels.editPage}}
      </button>
    </div>
    <div class="mel-storyboard-object-details-note-editor" data-note-editor-section hidden>
      <div data-note-editor></div>
    </div>
  </section>
  <footer class="mel-storyboard-object-details-actions">
    <button type="button" data-action="close"><i class="fas fa-xmark" aria-hidden="true"></i> {{labels.close}}</button>
  </footer>
</div>
