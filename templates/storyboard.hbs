<section class="mel-storyboard-workspace">
  <header class="mel-storyboard-toolbar">
    <h1>{{labels.title}}</h1>
    <div class="mel-storyboard-actions">
      <button type="button" class="icon-button" data-action="zoom-out" title="{{labels.zoomOut}}" aria-label="{{labels.zoomOut}}"><i class="fas fa-minus"></i></button>
      <button type="button" class="icon-button" data-action="zoom-in" title="{{labels.zoomIn}}" aria-label="{{labels.zoomIn}}"><i class="fas fa-plus"></i></button>
      <button type="button" class="icon-button" data-action="undo" {{#unless canUndo}}disabled{{/unless}} title="{{labels.undo}}" aria-label="{{labels.undo}}"><i class="fas fa-rotate-left"></i></button>
      <button type="button" class="icon-button" data-action="redo" {{#unless canRedo}}disabled{{/unless}} title="{{labels.redo}}" aria-label="{{labels.redo}}"><i class="fas fa-rotate-right"></i></button>
      <details class="mel-storyboard-command-menu">
        <summary>{{labels.importExport}}</summary>
        <div class="mel-storyboard-command-list">
          <button type="button" data-action="import-json">{{labels.importJson}}</button>
          <button type="button" data-action="export-json">{{labels.exportJson}}</button>
          <button type="button" data-action="export-svg">{{labels.exportSvg}}</button>
          <button type="button" data-action="export-png">{{labels.exportPng}}</button>
          <button type="button" data-action="export-pdf">{{labels.exportPdf}}</button>
        </div>
      </details>
    </div>
  </header>
  <input type="file" data-json-import accept="application/json,.json" hidden />

  <div class="mel-storyboard-layout">
    <aside class="mel-storyboard-sidebar {{#if sidebarCollapsed}}is-collapsed{{/if}}" aria-label="{{labels.scenes}}">
      <div class="mel-storyboard-sidebar-heading">
        <span class="mel-storyboard-tree-root"><i class="fas fa-folder-open" aria-hidden="true"></i> {{labels.story}}</span>
        <button type="button" class="icon-button" data-action="add-scene" title="{{labels.newScene}}" aria-label="{{labels.newScene}}"><i class="fas fa-plus"></i></button>
        <button type="button" class="icon-button" data-action="toggle-sidebar" title="{{#if sidebarCollapsed}}{{labels.expandSidebar}}{{else}}{{labels.collapseSidebar}}{{/if}}" aria-label="{{#if sidebarCollapsed}}{{labels.expandSidebar}}{{else}}{{labels.collapseSidebar}}{{/if}}"><i class="fas {{#if sidebarCollapsed}}fa-chevron-right{{else}}fa-chevron-left{{/if}}" aria-hidden="true"></i></button>
      </div>
      <ul class="mel-storyboard-scene-tree" role="tree" aria-label="{{labels.story}}">
        {{#if hasScenes}}
          {{#each sceneTree}}
            <li role="treeitem" aria-level="{{treeLevel}}" class="mel-storyboard-tree-item" style="--tree-depth: {{treeDepth}}">
              <button type="button" data-action="select-scene" data-scene-id="{{id}}" class="mel-storyboard-tree-node">
                <span class="mel-storyboard-tree-branch" aria-hidden="true"><i class="fas {{#if hasChildren}}fa-chevron-down{{else}}fa-circle{{/if}}"></i></span>
                <span class="mel-storyboard-tree-id">{{displayId}}</span>
                <span class="mel-storyboard-tree-title">{{title}}</span>
              </button>
            </li>
          {{/each}}
        {{else}}
          <li class="mel-storyboard-empty">{{labels.noScenes}}</li>
        {{/if}}
      </ul>
    </aside>

    <main class="mel-storyboard-canvas-region">
      <div class="mel-storyboard-canvas-scroll">
        <svg class="mel-storyboard-canvas" data-storyboard-canvas data-canvas-width="{{canvas.width}}" data-canvas-height="{{canvas.height}}" width="{{canvas.width}}" height="{{canvas.height}}" viewBox="0 0 {{canvas.width}} {{canvas.height}}" role="application" aria-label="{{labels.sceneCanvas}}">
          <defs>
            <pattern id="mel-storyboard-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(160, 175, 195, .14)" stroke-width="1"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#mel-storyboard-grid)" />
          {{#each board.connections}}
            <line class="mel-storyboard-connection" data-connection-id="{{id}}" x1="{{source.x}}" y1="{{source.y}}" x2="{{target.x}}" y2="{{target.y}}" />
            <polygon class="mel-storyboard-connection-arrow" data-connection-id="{{id}}" points="{{arrowPoints}}" />
            {{#if hasLabel}}<text class="mel-storyboard-connection-label" data-connection-id="{{id}}" x="{{labelPosition.x}}" y="{{labelPosition.y}}">{{label}}</text>{{/if}}
          {{/each}}
          {{#each board.elements}}
            <g class="mel-storyboard-element {{#if isSelected}}is-selected{{/if}}" data-scene-element data-element-id="{{id}}" transform="translate({{position.x}} {{position.y}})" tabindex="0" role="button" aria-label="{{label}}">
              <rect width="{{size.width}}" height="{{size.height}}" rx="10" />
              <text x="14" y="27">{{label}}</text>
              <text class="mel-storyboard-element-type" x="14" y="48">{{typeLabel}}</text>
              <rect class="mel-storyboard-element-status-badge" x="10" y="53" width="160" height="18" rx="9" />
              <text class="mel-storyboard-element-status" x="18" y="66">{{statusLabel}}</text>
            </g>
          {{/each}}
        </svg>
      </div>
    </main>

    <aside class="mel-storyboard-inspector {{#if inspectorCollapsed}}is-collapsed{{/if}}" aria-label="{{labels.inspector}}">
      {{#if selectedScene}}
        <header class="mel-storyboard-inspector-header">
          <div>
            <p class="mel-storyboard-display-id">{{selectedScene.displayId}}</p>
            <h2>{{labels.sceneDetails}}</h2>
          </div>
          <span class="mel-storyboard-status-badge">{{selectedScene.statusLabel}}</span>
          <button type="button" class="icon-button" data-action="toggle-inspector" title="{{#if inspectorCollapsed}}{{labels.expandInspector}}{{else}}{{labels.collapseInspector}}{{/if}}" aria-label="{{#if inspectorCollapsed}}{{labels.expandInspector}}{{else}}{{labels.collapseInspector}}{{/if}}"><i class="fas {{#if inspectorCollapsed}}fa-chevron-left{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i></button>
        </header>
        <section class="mel-storyboard-inspector-section">
          <label for="mel-storyboard-scene-title">{{labels.titleField}}</label>
          <input id="mel-storyboard-scene-title" type="text" value="{{selectedScene.title}}" data-scene-field="title" />
          <label for="mel-storyboard-scene-status">{{labels.status}}</label>
          <select id="mel-storyboard-scene-status" data-scene-field="status">
            {{#each statuses}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <label for="mel-storyboard-scene-description">{{labels.description}}</label>
          <textarea id="mel-storyboard-scene-description" rows="8" data-scene-field="description">{{selectedScene.description}}</textarea>
          <button type="button" data-action="save-scene"><i class="fas fa-save"></i> {{labels.save}}</button>
        </section>
        <section class="mel-storyboard-inspector-section mel-storyboard-object-section">
          <h3>{{labels.objects}}</h3>
          {{#if selectedObjects.length}}
            <div class="mel-storyboard-object-list">
              {{#each selectedObjects}}
                <article class="mel-storyboard-object-card">
                  <div class="mel-storyboard-object-main">
                    {{#if image}}<img src="{{image}}" alt="" aria-hidden="true" />{{else}}<i class="fas {{icon}}" aria-hidden="true"></i>{{/if}}
                    <div class="mel-storyboard-object-content">
                      {{#if foundryLinkHtml}}{{{foundryLinkHtml}}}{{else}}<strong>{{title}}</strong>{{/if}}
                      <span>{{typeLabel}}</span>
                      {{#if assignmentNotesPreview}}<small>{{assignmentNotesPreview}}</small>{{/if}}
                    </div>
                  </div>
                  <div class="mel-storyboard-object-actions">
                    <button type="button" class="icon-button" data-action="object-details" data-assignment-id="{{assignmentId}}" title="{{@root.labels.objectDetails}}" aria-label="{{@root.labels.objectDetails}}"><i class="fas fa-circle-info" aria-hidden="true"></i> {{@root.labels.objectDetails}}</button>
                    <button type="button" class="icon-button" data-action="edit-object-note" data-assignment-id="{{assignmentId}}" title="{{@root.labels.objectNote}}" aria-label="{{@root.labels.objectNote}}"><i class="fas fa-comment" aria-hidden="true"></i> {{@root.labels.objectNote}}</button>
                    <button type="button" class="icon-button" data-action="remove-object" data-assignment-id="{{assignmentId}}" title="{{@root.labels.deleteObject}}" aria-label="{{@root.labels.deleteObject}}"><i class="fas fa-xmark" aria-hidden="true"></i> {{@root.labels.deleteObject}}</button>
                  </div>
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="mel-storyboard-empty">{{labels.noObjects}}</p>
          {{/if}}
        </section>
        <section class="mel-storyboard-inspector-section mel-storyboard-connection-summary">
          <h3>{{labels.connections}}</h3>
          <div class="mel-storyboard-connection-counts">
            <span><strong>{{selectedScene.incomingCount}}</strong> {{labels.incoming}}</span>
            <span><strong>{{selectedScene.outgoingCount}}</strong> {{labels.outgoing}}</span>
          </div>
        </section>
      {{else}}
        <header class="mel-storyboard-inspector-header mel-storyboard-inspector-empty-header">
          <button type="button" class="icon-button" data-action="toggle-inspector" title="{{#if inspectorCollapsed}}{{labels.expandInspector}}{{else}}{{labels.collapseInspector}}{{/if}}" aria-label="{{#if inspectorCollapsed}}{{labels.expandInspector}}{{else}}{{labels.collapseInspector}}{{/if}}"><i class="fas {{#if inspectorCollapsed}}fa-chevron-left{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i></button>
        </header>
        {{#unless inspectorCollapsed}}<p class="mel-storyboard-empty">{{labels.selectScene}}</p>{{/unless}}
      {{/if}}
    </aside>
  </div>
  <p class="mel-storyboard-connection-status" data-connection-status>{{connectionStatus}}</p>
</section>
