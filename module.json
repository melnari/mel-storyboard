{
  "id": "mel-storyboard",
  "title": "Mel-Storyboard",
  "description": "A GM-focused visual scene board for planning and documenting branching roleplaying adventures.",
  "version": "0.0.2",
  "compatibility": {
    "minimum": "14",
    "verified": "14.360"
  },
  "authors": [
    {
      "name": "melnari",
      "url": "https://github.com/melnari/mel-storyboard"
    }
  ],
  "url": "https://github.com/melnari/mel-storyboard",
  "manifest": "https://raw.githubusercontent.com/melnari/mel-storyboard/main/module.json",
  "readme": "https://github.com/melnari/mel-storyboard/blob/main/README.md",
  "license": "LICENSE",
  "bugs": "https://github.com/melnari/mel-storyboard/issues",
  "changelog": "https://github.com/melnari/mel-storyboard/blob/main/CHANGELOG.md",
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/module.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "de", "name": "Deutsch", "path": "lang/de.json" },
    { "lang": "fr", "name": "Français", "path": "lang/fr.json" },
    { "lang": "es", "name": "Español", "path": "lang/es.json" },
    { "lang": "nl", "name": "Nederlands", "path": "lang/nl.json" }
  ]
}
